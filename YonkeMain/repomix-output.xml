      <div className="mt-6 text-center text-sm text-neutral-400">
        ¿Ya tienes una cuenta?{' '}
        <Link href="/auth/login" className="text-primary hover:underline font-medium">
          Inicia sesión aquí
        </Link>
      </div>
    </div>
  );
}
